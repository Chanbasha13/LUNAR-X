# ==============================================================================
# LUNAR-X (SIH26166) - Root Git Ignore Configuration
# ==============================================================================

# Raw Scientific Planetary Binary Images & Archives
*.img
*.IMG
*.zip
*.tar
*.tar.gz
*.tgz
*.npz
*.npy

# Deep Learning Model Checkpoints & Weights
*.ckpt
*.pth
*.pt
*.onnx
*.bin

# Node.js & Frontend Build Outputs
node_modules/
.next/
out/
build/
dist/
.npm/

# Python Virtual Environments & Packages
.venv/
venv/
env/
lunar_venv/
/Volumes/
/Users/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.cache/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Environment & Secret Files
.env
.env.*
!.env.example
*.pem
*.key

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# Whitelist / Preservation Rules
# Ensure final benchmark records and documentation remain tracked
# ==============================================================================
!backend/data/results/final_benchmark/
!backend/data/results/final_benchmark/*
!backend/data/results/final_benchmark/figures/*

backend/data/results/
